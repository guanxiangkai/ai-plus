<?xml version="1.0" encoding="UTF-8"?>
<plugin>
  <name>Artifact Plus Maven Plugin</name>
  <description>业务制品可选混淆与签名插件</description>
  <groupId>io.github.guanxiangkai</groupId>
  <artifactId>artifact-plus-maven-plugin</artifactId>
  <version>${moduleVersion}</version>
  <goalPrefix>artifact-protection</goalPrefix>
  <requiredMavenVersion>3.9.11</requiredMavenVersion>
  <mojos>
    <mojo>
      <goal>protect</goal>
      <description>生成独立的受保护 JAR 与可选签名。</description>
      <implementation>io.github.guanxiangkai.artifact.plus.maven.ProtectMojo</implementation>
      <language>java</language>
      <instantiationStrategy>per-lookup</instantiationStrategy>
      <executionStrategy>once-per-session</executionStrategy>
      <phase>verify</phase>
      <requiresDependencyResolution>runtime</requiresDependencyResolution>
      <requiresProject>true</requiresProject>
      <threadSafe>true</threadSafe>
      <parameters>
        <parameter><name>enabled</name><type>boolean</type><editable>true</editable><description>是否执行保护。</description></parameter>
        <parameter><name>obfuscationEnabled</name><type>boolean</type><editable>true</editable><description>是否混淆指定业务包。</description></parameter>
        <parameter><name>signingEnabled</name><type>boolean</type><editable>true</editable><description>是否为输出 JAR 生成签名。</description></parameter>
        <parameter><name>packages</name><type>java.util.List</type><editable>true</editable><description>允许混淆的业务包前缀。</description></parameter>
        <parameter><name>keepRules</name><type>java.io.File</type><editable>true</editable><description>可选 ProGuard 保留规则文件。</description></parameter>
        <parameter><name>inputJar</name><type>java.io.File</type><editable>true</editable><required>true</required><description>待保护的最终 JAR。</description></parameter>
        <parameter><name>outputJar</name><type>java.io.File</type><editable>true</editable><required>true</required><description>独立输出的受保护 JAR。</description></parameter>
        <parameter><name>mappingFile</name><type>java.io.File</type><editable>true</editable><required>true</required><description>混淆映射输出路径。</description></parameter>
        <parameter><name>privateKeyFile</name><type>java.io.File</type><editable>true</editable><description>签名用 PKCS#8 私钥文件。</description></parameter>
        <parameter><name>publicKeyFile</name><type>java.io.File</type><editable>true</editable><description>验签用 X.509 公钥文件。</description></parameter>
        <parameter><name>pluginArtifacts</name><type>java.util.List</type><editable>false</editable><description>插件运行时制品。</description></parameter>
        <parameter><name>project</name><type>org.apache.maven.project.MavenProject</type><editable>false</editable><required>true</required><description>当前 Maven 项目。</description></parameter>
      </parameters>
      <configuration>
        <enabled implementation="boolean" default-value="false">${artifact.protection.enabled}</enabled>
        <obfuscationEnabled implementation="boolean" default-value="false">${artifact.obfuscation.enabled}</obfuscationEnabled>
        <signingEnabled implementation="boolean" default-value="false">${artifact.signing.enabled}</signingEnabled>
        <packages implementation="java.util.List"/>
        <keepRules implementation="java.io.File"/>
        <inputJar implementation="java.io.File" default-value="${project.build.directory}/${project.build.finalName}.jar"/>
        <outputJar implementation="java.io.File" default-value="${project.build.directory}/protected/${project.build.finalName}.jar"/>
        <mappingFile implementation="java.io.File" default-value="${project.build.directory}/protected/mapping.txt"/>
        <privateKeyFile implementation="java.io.File" default-value="${env.ARTIFACT_SIGNING_PRIVATE_KEY_FILE}"/>
        <publicKeyFile implementation="java.io.File" default-value="${env.ARTIFACT_SIGNING_PUBLIC_KEY_FILE}"/>
        <pluginArtifacts implementation="java.util.List">${plugin.artifacts}</pluginArtifacts>
        <project implementation="org.apache.maven.project.MavenProject">${project}</project>
      </configuration>
      <requirements>
        <requirement>
          <role>org.apache.maven.project.MavenProjectHelper</role>
          <field-name>projectHelper</field-name>
        </requirement>
      </requirements>
    </mojo>
  </mojos>
  <dependencies>
    <dependency>
      <groupId>io.github.guanxiangkai</groupId>
      <artifactId>artifact-plus-core</artifactId>
      <type>jar</type>
      <version>${coreVersion}</version>
    </dependency>
    <dependency>
      <groupId>com.guardsquare</groupId>
      <artifactId>proguard-base</artifactId>
      <type>jar</type>
      <version>${proguardVersion}</version>
    </dependency>
  </dependencies>
</plugin>
